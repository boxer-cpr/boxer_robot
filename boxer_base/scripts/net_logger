import rospy
from boxer_base import NetLoggerNode
from boxer_firmware import flash
from cpr_common_srvs.srv import Bool

# def flash(file_name, target_ip, mac_addr, boot_port, tftp_port, packet_size_cb=None, display_cb=None):
LSPCU_DEFAULTS = {'file_name': 'mcu-lspcu.bin', 'target_ip': '10.253.253.2', 'mac_addr': '02:00:00:00:00:02'}
TDCU_DEFAULTS = {'file_name': 'mcu-tdcu.bin', 'target_ip': '10.253.253.3', 'mac_addr': '02:00:00:00:00:03'}

def flash_firmware(arg):
  """Service server for flashing LSPCU and TDCU.
  :param arg: Service msg
  :type arg: cpr_common_srvs Bool
  """

  result = True

  lspcu_args = rospy.get_param('~lspcu_firmware', LSPCU_DEFAULTS)
  rospy.loginfo(lspcu_args)
  tdcu_args = rospy.get_param('~tdcu_firmware', TDCU_DEFAULTS)
  rospy.loginfo(tdcu_args)

  try:
    flash(**tdcu_args)
  except Exception as e:
    rospy.logerr('Failed to flash TDCU: %s' % e)
    result = False

  # Sleep and let the TDCU finish cleanup.
  rospy.sleep(2)

  try:
    flash(**lspcu_args)
  except Exception as e:
    rospy.logerr('Failed to flash LSPCU: %s' % e)
    result = False

  return result


if __name__ == '__main__':
  # Create flash service for updating firmware for LSPCU and TDCU.
  s = rospy.Service('flash_firmware', Bool, flash_firmware)

  rospy.init_node('net_logger', anonymous=True)
  logger_node = NetLoggerNode()
  logger_node.run()
