#!/usr/bin/env python

import yaml
import argparse

parser = argparse.ArgumentParser()
parser.add_argument('--filein', help='Input file name/path to be updated.')
args = parser.parse_args()

print('Loading .yaml file : ', args.filein)
with open(args.filein, 'r') as in_f:
  calib_data = yaml.load(in_f)
print(calib_data)

# Update all values
calib_data['image_width'] *= 2
calib_data['image_height'] *= 2

calib_data['camera_matrix']['data'][0] *= 2
calib_data['camera_matrix']['data'][2] *= 2
calib_data['camera_matrix']['data'][4] *= 2
calib_data['camera_matrix']['data'][5] *= 2

calib_data['projection_matrix']['data'][0] *= 2
calib_data['projection_matrix']['data'][2] *= 2
calib_data['projection_matrix']['data'][3] *= 2
calib_data['projection_matrix']['data'][5] *= 2
calib_data['projection_matrix']['data'][6] *= 2

print('\n \n \n')
print('new calib data : ', calib_data)
print('\n \n \n')
print('Writing .yaml file : ', args.filein)
with open(args.filein, 'w') as out_f:
  yaml.dump(calib_data, out_f)
