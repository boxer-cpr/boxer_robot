import rospy
import numpy as n
from geometry_msgs.msg import Twist

pub = rospy.Publisher('cmd_vel', Twist, queue_size=1)
rospy.init_node('pingpong')

r = rospy.Rate(20)
spd = 1.5
stp = 0.05
t = Twist()


while not rospy.is_shutdown():
  for s in n.arange(0, spd, stp):
    t.linear.x = s
    pub.publish(t)
    r.sleep()
  for s in n.arange(-spd, spd, stp):
    t.linear.x = spd
    pub.publish(t)
    r.sleep()
  for s in n.arange(spd, 0, -stp):
    t.linear.x = s
    pub.publish(t)
    r.sleep()
  rospy.sleep(rospy.Duration(20.0))

  for s in n.arange(0, -spd, -stp):
    t.linear.x = s
    pub.publish(t)
    r.sleep()
  for s in n.arange(spd, -spd, -stp):
    t.linear.x = -spd
    pub.publish(t)
    r.sleep()
  for s in n.arange(-spd, 0, stp):
    t.linear.x = s
    pub.publish(t)
    r.sleep()
  rospy.sleep(rospy.Duration(20.0))

